# Copy to .env (never commit it).
# Host side of the deployment (docker-compose.yml)
# Ports the host publishes, and the address they bind to (127.0.0.1 if the proxy runs on the same machine).
PUBLIC_HOST_PORT=8080
ADMIN_HOST_PORT=8081
BIND_ADDRESS=0.0.0.0
# The private site-admin port binds to 127.0.0.1 unless you set this (e.g. a LAN IP). Never expose it to the internet.
# ADMIN_BIND_ADDRESS=127.0.0.1
# Where the SQLite DB and uploaded images live. On TrueNAS use an absolute dataset path, e.g. /mnt/tank/apps/wedding-rsvp
DATA_DIR=./data
# User/group the container runs as (owner of DATA_DIR). Default is the image's non-root user 1654 — run
# `chown 1654:1654 ./data` once (or `sudo chown -R` the DATA_DIR). On TrueNAS use the app's uid, e.g. 568.
APP_UID=1654
APP_GID=1654
# Only for docker-compose.npm.yml (shared Docker network with Nginx Proxy Manager)
NPM_NETWORK=npm_default
# Delivery reports: set a long random value to turn them on. SMS4FREE is then told to POST its delivery report to
# <App__PublicBaseUrl>/webhooks/sms-delivery/<this value> (needs a public, non-localhost App__PublicBaseUrl). Empty = off.
App__DeliveryWebhookSecret=
# Log (dev, writes to the console) or Sms4Free
Sms__Provider=Log
# Public origin used in guest SMS links and in couples' set-password links. Keep it short: every character counts toward the SMS length
# (link = this + "/" + 10-char token). Serving the guest page from the bare domain saves the most.
App__PublicBaseUrl=https://example.com
# Let the private admin port (site admin) serve sign-in over plain HTTP, e.g. http://<lan-ip>:8091/signin with no certificate.
# Off by default. The public port always requires HTTPS. The admin password then crosses your LAN unencrypted.
App__AdminAllowPlainHttp=false
# Cloudflare Turnstile (bot protection on the couples' sign-in pages and on the invitation; SPEC.md section 13).
# ON only when BOTH keys are set. The site key is public. The secret key is secret: put it here yourself, never in the repo or in chat.
# After setting them run: scripts/check-turnstile.sh
App__TurnstileSiteKey=
App__TurnstileSecretKey=
# Optional: hostnames Cloudflare may report for a valid token (comma-separated). Empty = the host of App__PublicBaseUrl.
# App__TurnstileAllowedHostnames=
# First site admin (used once when the database has no users)
App__BootstrapAdminEmail=
App__BootstrapAdminPassword=
# SMS4FREE credentials (account API page)
Sms__ApiUser=
Sms__ApiPassword=
Sms__ApiKey=
