# Copy to .env (never commit it).
NPM_NETWORK=npm_default
# Leave empty until SMS4FREE delivery reports are confirmed (SPEC.md §6)
App__DeliveryWebhookSecret=
# Log (dev, writes to the console) or Sms4Free
Sms__Provider=Log
# Public origin used in guest SMS links. Keep it short: every character counts toward the SMS length
# (link = this + "/" + 10-char token). Serving the guest page from the bare domain saves the most.
App__PublicBaseUrl=https://example.com
# First site admin (planned, used once when the database has no users)
App__AdminBaseUrl=https://admin.example.com
App__BootstrapAdminEmail=
App__BootstrapAdminPassword=
# SMS4FREE credentials (account API page)
Sms__ApiUser=
Sms__ApiPassword=
Sms__ApiKey=
