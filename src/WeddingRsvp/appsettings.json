{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": "http://localhost:8080",
    "DataDir": "data",
    "PublicPort": 8080,
    "AdminPort": 8081,
    "DeliveryWebhookSecret": ""
  },
  "Sms": {
    "Provider": "Log",
    "ApiUser": "",
    "ApiPassword": "",
    "ApiKey": ""
  },
  "Sending": {
    "TickSeconds": 20,
    "BatchSize": 20,
    "MaxAttempts": 3,
    "DayStartHour": 9,
    "DayEndHour": 21,
    "FridayEndHour": 13
  }
}
