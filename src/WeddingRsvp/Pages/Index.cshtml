@page "/"
@{
    Layout = null;
    var title = Ui.T("הזמנות ואישורי הגעה לחתונה, ישירות ב-SMS", "Wedding invitations and RSVPs, straight by SMS");
}
<!DOCTYPE html>
<html lang="@Ui.Lang" dir="@Ui.Dir">
<head>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@Ui.T("אישורי הגעה", "RSVP")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
    <header class="bar">
        <a href="/" class="brand">
            <span class="logo"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg></span>
            @Ui.T("אישורי הגעה", "RSVP")
        </a>
        <div class="tools">
            <nav class="lang" aria-label="@Ui.T("שפה", "Language")">
                <a href="/lang/he?returnUrl=/" class="@(Ui.IsHebrew ? "on" : "")">עברית</a>
                <a href="/lang/en?returnUrl=/" class="@(Ui.IsHebrew ? "" : "on")">English</a>
            </nav>
            <a href="/signin" class="signin">@Ui.T("כניסה", "Sign in")</a>
        </div>
    </header>

    <main>
        <section class="hero">
            <h1>@title</h1>
            <p>@Ui.T("שולחים לכל אורח קישור אישי, האורחים מאשרים הגעה בלחיצה, ואתם רואים את התמונה המלאה במקום אחד.",
                     "Every guest gets a personal link, guests confirm with a tap, and you see the whole picture in one place.")</p>
            <a href="/signin" class="cta">
                @Ui.T("כניסה לניהול האירוע", "Sign in to manage your event")
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
            </a>
            <div class="guest">
                <span class="ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/></svg></span>
                <div>
                    <strong>@Ui.T("קיבלתם הזמנה?", "Got an invitation?")</strong>
                    <span>@Ui.T("אין צורך להתחבר. פתחו את הקישור האישי מהודעת ה-SMS שקיבלתם.", "No need to sign in. Open the personal link from the SMS you received.")</span>
                </div>
            </div>
        </section>

        <section class="how" aria-labelledby="how">
            <h2 id="how">@Ui.T("איך זה עובד", "How it works")</h2>
            <ol>
                <li>
                    <span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg></span>
                    <strong>@Ui.T("הזמנה אישית ב-SMS", "Personal SMS invitations")</strong>
                    <span>@Ui.T("כל אורח מקבל הודעה עם קישור משלו להזמנה ולאישור ההגעה.", "Each guest gets a message with their own link to the invitation and RSVP.")</span>
                </li>
                <li>
                    <span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <strong>@Ui.T("אישור בלחיצה", "One-tap RSVP")</strong>
                    <span>@Ui.T("האורחים בוחרים אם יגיעו וכמה יהיו, בלי להירשם ובלי אפליקציה.", "Guests say whether they are coming and how many, with no sign-up and no app.")</span>
                </li>
                <li>
                    <span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></svg></span>
                    <strong>@Ui.T("הכל בלוח אחד", "One dashboard")</strong>
                    <span>@Ui.T("מי אישר, מי עוד לא ענה, ותזכורות למי שצריך.", "Who confirmed, who has not answered yet, and reminders for those who need one.")</span>
                </li>
            </ol>
        </section>
    </main>
</body>
</html>
