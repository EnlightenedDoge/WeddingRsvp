@page "/admin/site/security"
@model WeddingRsvp.Pages.SiteAdmin.SecurityModel
@{ ViewData["Title"] = Ui.T("אבטחה", "Security"); }
<header class="page-head"><h1>@Ui.T("אבטחה", "Security")</h1></header>

<section class="card">
    <h2>@Ui.T("החלפת סיסמה", "Change password")</h2>
    @if (Model.PasswordError is not null) { <p class="banner err" role="alert">@Model.PasswordError</p> }
    <form method="post" asp-page-handler="Password">
        <div class="fields">
            <label class="field"><span>@Ui.T("סיסמה נוכחית", "Current password")</span>
                <input name="Current" type="password" autocomplete="current-password" required /></label>
            <label class="field"><span>@Ui.T("סיסמה חדשה (לפחות 10 תווים)", "New password (at least 10 characters)")</span>
                <input name="New" type="password" autocomplete="new-password" minlength="10" required /></label>
            <label class="field"><span>@Ui.T("אימות סיסמה חדשה", "Confirm the new password")</span>
                <input name="Confirm" type="password" autocomplete="new-password" minlength="10" required /></label>
        </div>
        <p class="faint">@Ui.T("שאר ההתחברויות של החשבון ינותקו.", "Your other signed-in sessions will be signed out.")</p>
        <button type="submit" class="btn primary">@Ui.T("עדכון סיסמה", "Update password")</button>
    </form>
</section>

<section class="card">
    <h2>@Ui.T("אימות דו-שלבי (TOTP)", "Two-factor authentication (TOTP)")</h2>
    @if (Model.Enabled)
    {
        <p>@Ui.T("פעיל.", "Enabled.")</p>
        <form method="post" asp-page-handler="Disable">
            <label class="field"><span>@Ui.T("סיסמה", "Password")</span><input name="Password" type="password" required autocomplete="current-password" /></label>
            <button type="submit" class="btn primary">@Ui.T("ביטול", "Disable")</button>
        </form>
    }
    else
    {
        <p>@Ui.T("הוסיפו את המפתח באפליקציית אימות (Google Authenticator, Authy, 1Password…), ואז הזינו את הקוד.",
            "Add this key to an authenticator app (Google Authenticator, Authy, 1Password…), then enter the code.")</p>
        <p>@Ui.T("מפתח", "Key"): <code class="ltr">@Model.SharedKey</code></p>
        <p>@Ui.T("או הדביקו את הקישור באפליקציה", "Or paste this URI into the app"):</p>
        <input class="copy-box" readonly value="@Model.Uri" onfocus="this.select()" />
        @if (Model.Error is not null)
        {
            <p class="banner err" role="alert">@Model.Error</p>
        }
        <form method="post" asp-page-handler="Enable">
            <label class="field"><span>@Ui.T("קוד", "Code")</span><input name="Code" inputmode="numeric" required class="ltr" autocomplete="off" /></label>
            <button type="submit" class="btn primary">@Ui.T("הפעלה", "Enable")</button>
        </form>
    }
</section>
