@page "/admin/site/couples"
@model WeddingRsvp.Pages.SiteAdmin.CouplesModel
@{ ViewData["Title"] = Ui.T("זוגות", "Couples"); }
<header class="page-head">
    <div><h1>@Ui.T("זוגות", "Couples")</h1><div class="sub">@Model.Rows.Count @Ui.T("חשבונות", "accounts")</div></div>
    <a class="btn primary" href="/admin/site/couples/new">@Ui.T("יצירת חשבון לזוג", "Create a couple's account")</a>
</header>
<section class="card">
    <div class="tablewrap"><table>
        <thead><tr><th>@Ui.T("שם", "Name")</th><th>@Ui.T("אימייל", "Email")</th><th>@Ui.T("אורחים", "Guests")</th><th>@Ui.T("מצב", "Status")</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td><a class="link" href="/admin/site/couples/@r.Id">@r.DisplayName</a></td>
                <td class="ltr">@r.Email</td>
                <td>@r.Guests</td>
                <td>@if (r.Suspended) { <span class="pill no">@Ui.T("מושעה", "Suspended")</span> }
                    else if (r.HasPassword) { <span class="pill ok">@Ui.T("פעיל", "Active")</span> }
                    else { <span class="pill wait">@Ui.T("ממתין להגדרת סיסמה", "Awaiting password")</span> }</td>
            </tr>
        }
        </tbody>
    </table></div>
    @if (Model.Rows.Count == 0) { <p class="muted">@Ui.T("עדיין אין זוגות.", "No couples yet.")</p> }
</section>
