@page "/admin/site/couples/{id:int}"
@model WeddingRsvp.Pages.SiteAdmin.CoupleDetailModel
@{ ViewData["Title"] = Model.Couple.DisplayName; }
<h1>@Model.Couple.DisplayName</h1>
<p dir="ltr">@Model.Email</p>
<p>@(Model.Couple.Suspended ? Ui.T("מושעה", "Suspended") : Ui.T("פעיל", "Active")) ·
   @(Model.HasPassword ? Ui.T("הסיסמה הוגדרה", "Password set") : Ui.T("ממתין להגדרת סיסמה", "Awaiting password"))</p>

@if (Model.Link is not null)
{
    <section>
        <h2>@Ui.T("קישור חד-פעמי להגדרת סיסמה", "One-time set-password link")</h2>
        <p>@Ui.T("העתיקו ושלחו לזוג בעצמכם. הקישור תקף 7 ימים ומציג רק פעם אחת.",
            "Copy it and send it to the couple yourself. Valid for 7 days. Shown only now.")</p>
        <input class="copy-box" readonly value="@Model.Link" onfocus="this.select()" />
    </section>
}

<section>
    <form method="post" asp-page-handler="NewLink" class="inline">
        <button type="submit">@Ui.T("יצירת קישור חדש (מבטל את הקודם)", "Generate a new link (invalidates the old one)")</button>
    </form>
    <form method="post" asp-page-handler="@(Model.Couple.Suspended ? "Resume" : "Suspend")" class="inline">
        <button type="submit">@(Model.Couple.Suspended ? Ui.T("הפעלה מחדש", "Reactivate") : Ui.T("השעיה", "Suspend"))</button>
    </form>
</section>
<p><a href="/admin/site/couples">@Ui.T("חזרה לרשימה", "Back to the list")</a></p>
