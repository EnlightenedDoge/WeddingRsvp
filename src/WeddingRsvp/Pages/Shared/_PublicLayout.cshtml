@using WeddingRsvp.Domain
@{
    var lang = ViewData["Lang"] as string ?? "he";
    var bg = ViewData["Bg"] as string ?? HexColor.DefaultBackground;
    var accent = ViewData["Accent"] as string ?? HexColor.DefaultAccent;
    var dark = ViewData["Dark"] as bool? ?? false;
    var bgImage = ViewData["BgImage"] as string;
    // Text on accent-coloured buttons flips by luminance, like the page text does.
    var onAccent = HexColor.IsDark(accent) ? "#fff" : "#1E2321";
}
<!DOCTYPE html>
<html lang="@lang" dir="@(lang == "en" ? "ltr" : "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
</head>
@* bg/accent come from HexColor-validated values only; bgImage is a server-built path. *@
<body class="@(dark ? "dark" : "")" style="--bg: @bg; --accent: @accent; --on-accent: @onAccent;@(bgImage is null ? "" : $" --bg-image: url('{bgImage}');")">
    @RenderBody()
</body>
</html>
