<!DOCTYPE html>
<html lang="@Ui.Lang" dir="@Ui.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="auth">
        <div>
            <div class="auth-card">
                <div class="brand">
                    <span class="logo"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg></span>
                    @Ui.T("RSVP חתונה", "Wedding RSVP")
                </div>
                @if (TempData["Flash"] is string flash)
                {
                    <p class="flash" role="status">@flash</p>
                }
                @RenderBody()
            </div>
            <div class="langsw" style="width: fit-content; margin-inline: auto">
                <a href="/lang/he?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)" class="@(Ui.IsHebrew ? "on" : "")">עברית</a>
                <a href="/lang/en?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)" class="@(Ui.IsHebrew ? "" : "on")">English</a>
            </div>
        </div>
    </div>
</body>
</html>
