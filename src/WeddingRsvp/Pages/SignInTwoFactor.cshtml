@page "/signin/2fa"
@model WeddingRsvp.Pages.SignInTwoFactorModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Ui.T("קוד אימות", "Verification code");
}
<h1>@Ui.T("קוד אימות", "Verification code")</h1>
<p>@Ui.T("הזינו את הקוד בן 6 הספרות מאפליקציית האימות.", "Enter the 6-digit code from your authenticator app.")</p>
@if (Model.Error is not null)
{
    <p class="banner err" role="alert">@Model.Error</p>
}
<form method="post">
    <label class="field"><span>@Ui.T("קוד", "Code")</span>
        <input name="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" required autofocus class="ltr" /></label>
    <button type="submit" class="btn primary">@Ui.T("אישור", "Verify")</button>
</form>
