@page "/signin"
@model WeddingRsvp.Pages.SignInModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Ui.T("כניסה", "Sign in");
}
<h1>@Ui.T("כניסה", "Sign in")</h1>
@if (Model.Error is not null)
{
    <p class="banner err" role="alert">@Model.Error</p>
}
<form method="post">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <label class="field"><span>@Ui.T("אימייל", "Email")</span>
        <input name="Email" type="email" class="ltr" value="@Model.Email" autocomplete="username" required autofocus /></label>
    <label class="field"><span>@Ui.T("סיסמה", "Password")</span>
        <input name="Password" type="password" autocomplete="current-password" required /></label>
    <partial name="_Turnstile" model='"signin"' />
    <button type="submit" class="btn primary">@Ui.T("כניסה", "Sign in")</button>
</form>
