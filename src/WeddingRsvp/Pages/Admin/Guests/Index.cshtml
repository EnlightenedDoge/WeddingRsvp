@page
@model WeddingRsvp.Pages.Admin.Guests.IndexModel
@{ ViewData["Title"] = Ui.T("אורחים", "Guests"); }
<header class="page-head">
    <div><h1>@Ui.T("אורחים", "Guests")</h1><div class="sub">@(Model.ShowFamilies ? Model.Families.Count + " " + Ui.T("משפחות", "families") : Model.Guests.Count + " " + Ui.T("הזמנות", "invitations"))</div></div>
    <div class="row">
        <a class="btn" href="/admin/export.csv">@Ui.T("ייצוא CSV", "Export CSV")</a>
        <a class="btn" href="/admin/import">@Ui.T("ייבוא רשימה", "Import list")</a>
        <a class="btn primary" href="/admin/guests/edit">@Ui.T("הוספת אורח", "Add guest")</a>
    </div>
</header>

<nav class="tabs" aria-label="@Ui.T("תצוגה", "View")">
    <a href="/admin/guests" class="@(Model.ShowFamilies ? "" : "on")">@Ui.T("אורחים", "Guests")</a>
    <a href="/admin/guests?view=families" class="@(Model.ShowFamilies ? "on" : "")">@Ui.T("משפחות (מזהה משפחה)", "Families (family id)")</a>
</nav>

@if (Model.ShowFamilies)
{
<section class="card">
    <form method="get" class="toolbar">
        <input type="hidden" name="view" value="families" />
        <input type="search" name="q" value="@Model.Q" placeholder="@Ui.T("חיפוש לפי משפחה, מזהה או שם", "Search by family, id or member name")" />
        <button type="submit" class="btn">@Ui.T("חיפוש", "Search")</button>
    </form>
    <div class="tablewrap">
    <table>
        <thead><tr>
            <th>@Ui.T("משפחה (מזהה)", "Family (id)")</th><th>@Ui.T("בני משפחה", "Members")</th><th>@Ui.T("מוזמנים", "Invited")</th>
            <th>@Ui.T("תשובה", "Answer")</th>
        </tr></thead>
        <tbody>
        @foreach (var f in Model.Families)
        {
            var a = f.Answer;
            <tr>
                <td><b>@f.Family.Name</b> <span class="faint ltr">(@f.Identifier)</span></td>
                <td>@foreach (var m in f.Members) { <div><a href="/admin/guests/edit/@m.Id">@m.Name</a> <span class="faint ltr">@m.PhoneRaw</span></div> }</td>
                <td>@(f.Invited is { } n ? n.ToString() : Ui.T("ללא הגבלה", "No limit"))</td>
                <td><span class="pill @Labels.StatusPill(a.Status)">@Labels.Status(a.Status)@(a.Status == RsvpStatus.Attending ? " · " + Labels.Headcount(a.AttendingAdults, a.AttendingChildren) : "")</span>@if (a.HasDiet) { <span class="pill" title="@a.DietNote">@Ui.T("תזונה", "Diet")</span> }@if (a.Status == RsvpStatus.Attending) { <div><button type="button" class="link qe-open" data-id="@a.Id" data-name="@a.Name" data-adults="@a.AttendingAdults" data-children="@a.AttendingChildren" data-veg="@a.DietVegetarian" data-vegan="@a.DietVegan" data-gf="@a.DietGlutenFree" data-note="@a.DietNote" data-family="@(a.FamilyId is null ? "0" : "1")">@Ui.T("עריכת כמות", "Edit headcount")</button></div> }</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    @if (Model.Families.Count == 0) { <p class="muted">@Ui.T("עוד אין משפחות. אפשר לקבץ אורחים למשפחה בעריכת אורח או בייבוא (עמודות שם משפחה ומזהה משפחה).", "No families yet. Group guests into a family when editing a guest, or in the import (family name and family identifier columns).")</p> }
</section>
}
else
{
<section class="card">
    <form method="get" class="toolbar">
        <select asp-for="Filter" asp-items="Model.FilterOptions" style="flex: 0 1 220px"></select>
        <input type="search" name="q" value="@Model.Q" placeholder="@Ui.T("חיפוש לפי שם או טלפון", "Search by name or phone")" />
        <button type="submit" class="btn">@Ui.T("סינון", "Filter")</button>
    </form>
    <form method="post" asp-page-handler="Bulk" id="bulk">
    <input type="hidden" name="returnUrl" value="@(Request.Path + Request.QueryString)" />
    <div class="tablewrap">
    <table>
        <thead><tr>
            <th class="selcell"><input type="checkbox" id="selall" aria-label="@Ui.T("בחירת כל האורחים המוצגים", "Select all shown guests")" /></th>
            <th>@Ui.T("שם", "Name")</th><th>@Ui.T("טלפון", "Phone")</th><th>@Ui.T("מוזמנים", "Invited")</th>
            <th>@Ui.T("סטטוס", "Status")</th><th>@Ui.T("הזמנה נשלחה", "Invite sent")</th>
            <th>@Ui.T("תזכורות", "Reminders")</th><th>@Ui.T("פתחו קישור", "Opened link")</th><th aria-hidden="true"></th>
        </tr></thead>
        <tbody>
        @foreach (var g in Model.Guests)
        {
            <tr class="clickrow @(g.PhoneE164 is null ? "bad" : "")" data-href="/admin/guests/edit/@g.Id">
                <td class="selcell"><input type="checkbox" name="ids" value="@g.Id" class="selrow" aria-label="@Ui.T("בחירה", "Select") @g.Name" /></td>
                <td><a href="/admin/guests/edit/@g.Id"><b>@g.Name</b></a>@if (g.GroupLinkId is not null) { <div class="faint">@Ui.T("דרך קישור קבוצתי", "Via group link")@(g.IsChild ? " · " + Ui.T("ילד/ה", "child") : "")</div> }</td>
                <td class="ltr">@g.PhoneRaw @if (g.PhoneError is not null) { <div class="faint">@Labels.Problem(g.PhoneError)</div> }</td>
                <td>@(g.NoGuestLimit ? Ui.T("ללא הגבלה", "No limit") : g.InvitedCount.ToString())</td>
                <td><span class="pill @Labels.StatusPill(g.Status)">@Labels.Status(g.Status)@(g.Status == RsvpStatus.Attending ? " · " + Labels.Headcount(g.AttendingAdults, g.AttendingChildren) : "")</span>@if (g.HasDiet) { <span class="pill" title="@g.DietNote">@Ui.T("תזונה", "Diet")</span> }@if (g.Status == RsvpStatus.Attending) { <div><button type="button" class="link qe-open" data-id="@g.Id" data-name="@g.Name" data-adults="@g.AttendingAdults" data-children="@g.AttendingChildren" data-veg="@g.DietVegetarian" data-vegan="@g.DietVegan" data-gf="@g.DietGlutenFree" data-note="@g.DietNote" data-family="@(g.FamilyId is null ? "0" : "1")">@Ui.T("עריכת כמות", "Edit headcount")</button></div> }</td>
                <td>@Labels.Local(g.InviteSentAtUtc)</td>
                <td>@g.RemindersSent</td>
                <td>@Labels.Local(g.FirstOpenedAtUtc)</td>
                <td class="chevcell" aria-hidden="true"><svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <div class="bulkbar" id="bulkbar" hidden>
        <b><span id="bulkcount">0</span> @Ui.T("נבחרו", "selected")</b>
        <select name="action" id="bulkaction" aria-label="@Ui.T("פעולה", "Action")">
            <option value="">@Ui.T("בחרו פעולה…", "Choose an action…")</option>
            <option value="invite">@Ui.T("שליחת הזמנה", "Send invitation")</option>
            <option value="family">@Ui.T("הוספה למשפחה", "Add to a family")</option>
            <option value="unfamily">@Ui.T("הוצאה ממשפחה", "Remove from family")</option>
            <option value="invited">@Ui.T("שינוי מספר מוזמנים", "Set people invited")</option>
            <option value="export">@Ui.T("ייצוא CSV של הנבחרים", "Export selected (CSV)")</option>
            <option value="delete">@Ui.T("מחיקה", "Delete")</option>
        </select>
        <span class="bulkopt" data-for="family">
            <select name="familyId" id="bulkfamily" aria-label="@Ui.T("משפחה", "Family")">
                @foreach (var f in Model.FamilyOptions) { <option value="@f.Id">@f.Name@(f.Members.Length > 0 ? " · " + f.Members : "")</option> }
                <option value="-1">@Ui.T("משפחה חדשה…", "New family…")</option>
            </select>
            <input name="familyName" id="bulkfamname" maxlength="@Family.NameMax" placeholder="@Ui.T("שם המשפחה החדשה", "New family name")" />
            <span class="hint">@Ui.T("אם כבר ענו כמה מהם, התשובה האחרונה תחול על כולם.", "If several have already answered, the most recent answer applies to everyone.")</span>
        </span>
        <span class="bulkopt" data-for="invited">
            <input name="invited" type="number" min="1" max="50" value="1" style="width: 90px" aria-label="@Ui.T("מוזמנים", "Invited")" />
            <label class="checks"><input type="checkbox" name="noLimit" value="true" /> @Ui.T("ללא הגבלה", "No limit")</label>
        </span>
        <button type="submit" class="btn primary" id="bulkgo">@Ui.T("ביצוע", "Apply")</button>
        <button type="button" class="btn" id="bulkclear">@Ui.T("ניקוי בחירה", "Clear")</button>
    </div>
    </form>
    @if (Model.Guests.Count == 0)
    {
        <p class="muted">@Ui.T("אין אורחים להצגה.", "No guests to show.")</p>
    }
</section>

<script>
    // Bulk selection: the bar shows while something is ticked; the options that belong to the chosen action show with it.
    (function () {
        var form = document.getElementById('bulk');
        if (!form) return;
        var rows = Array.prototype.slice.call(form.querySelectorAll('.selrow')), all = document.getElementById('selall');
        var bar = document.getElementById('bulkbar'), count = document.getElementById('bulkcount'), action = document.getElementById('bulkaction');
        var fam = document.getElementById('bulkfamily'), famName = document.getElementById('bulkfamname');
        function sync() {
            var n = rows.filter(function (r) { return r.checked; }).length;
            count.textContent = n; bar.hidden = n === 0;
            all.checked = n > 0 && n === rows.length; all.indeterminate = n > 0 && n < rows.length;
            form.querySelectorAll('.bulkopt').forEach(function (o) { o.hidden = o.dataset.for !== action.value; });
            if (fam) famName.hidden = fam.value !== '-1';
        }
        rows.forEach(function (r) { r.addEventListener('change', sync); });
        all.addEventListener('change', function () { rows.forEach(function (r) { r.checked = all.checked; }); sync(); });
        action.addEventListener('change', sync);
        if (fam) fam.addEventListener('change', sync);
        document.getElementById('bulkclear').addEventListener('click', function () { rows.forEach(function (r) { r.checked = false; }); sync(); });
        form.addEventListener('submit', function (e) {
            if (!action.value) { e.preventDefault(); action.focus(); return; }
            var n = rows.filter(function (r) { return r.checked; }).length;
            var msgs = { delete: '@Ui.T("למחוק את האורחים שנבחרו?", "Delete the selected guests?")', invite: '@Ui.T("לשלוח הזמנה לאורחים שנבחרו שעוד לא הוזמנו?", "Send the invitation to the selected guests who are not invited yet?")' };
            if (msgs[action.value] && !confirm(msgs[action.value] + ' (' + n + ')')) e.preventDefault();
        });
        sync();
    })();
    // The whole row opens the guest (the name stays a real link for keyboard and middle-click). Selecting text doesn't navigate.
    document.querySelectorAll('tr.clickrow').forEach(function (row) {
        row.addEventListener('click', function (e) {
            if (e.target.closest('a, button, input, select, label, td.selcell')) return;
            if (window.getSelection && String(window.getSelection())) return;
            if (e.ctrlKey || e.metaKey) window.open(row.dataset.href, '_blank'); else window.location.href = row.dataset.href;
        });
    });
</script>
}
<partial name="_QuickEdit" />
