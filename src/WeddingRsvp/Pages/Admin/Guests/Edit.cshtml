@page "{id:int?}"
@model WeddingRsvp.Pages.Admin.Guests.EditModel
@{
    var title = Model.Existing?.Name ?? Ui.T("אורח חדש", "New guest");
    ViewData["Title"] = title;
}
<header class="page-head">
    <div><h1>@title</h1><div class="sub"><a class="link" href="/admin/guests">← @Ui.T("לרשימת האורחים", "Back to guests")</a></div></div>
</header>

<div class="grid2">
<section class="card wide">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <div class="fields">
            <label class="field"><span>@Ui.T("שם", "Name")</span><input asp-for="Input.Name" />
                <span asp-validation-for="Input.Name" class="field-validation-error"></span></label>
            <label class="field"><span>@Ui.T("טלפון", "Phone")</span><input asp-for="Input.Phone" class="ltr" inputmode="tel" />
                <span asp-validation-for="Input.Phone" class="field-validation-error"></span>
                @if (Model.Existing?.PhoneError is { } err) { <small class="error">@Labels.Problem(err)</small> }</label>
            <div class="field"><span>@Ui.T("משפחה", "Family")</span>
                <select asp-for="Input.FamilyId" id="familyPick" aria-label="@Ui.T("משפחה", "Family")">
                    <option value="0">@Ui.T("ללא משפחה", "No family")</option>
                    @foreach (var f in Model.Families) { <option value="@f.Id">@f.Name@(f.Members.Length > 0 ? " · " + f.Members : "")</option> }
                    <option value="-1">@Ui.T("משפחה חדשה…", "New family…")</option>
                </select>
                <input asp-for="Input.FamilyName" id="familyName" maxlength="@Family.NameMax" placeholder="@Ui.T("שם המשפחה (למשל כהן)", "Family name (e.g. Cohen)")" />
                <small>@Ui.T("אורחים באותה משפחה חולקים תשובה אחת: תשובה של אחד תקפה לכולם, והדף פונה אליהם \"משפחת …\". שם משפחה יכול להופיע יותר מפעם אחת; אפשר גם לשנות כאן את שם המשפחה שנבחרה.", "Guests in the same family share one answer: one member's reply counts for all, and the page greets them as \"… family\". A name can be used by more than one family; you can also rename the selected family here.")</small>
                <span asp-validation-for="Input.FamilyName" class="field-validation-error"></span></div>
            <div class="field"><span>@Ui.T("מספר מוזמנים", "People invited")</span>
                <div class="row">
                    <input asp-for="Input.InvitedCount" id="invitedNumber" type="number" min="0" max="50" style="flex: 0 1 120px" aria-label="@Ui.T("מספר מוזמנים", "People invited")" />
                    <label class="checks"><input asp-for="Input.NoLimit" id="noLimit" /> @Ui.T("ללא הגבלה", "No guest limit")</label>
                </div>
                <small>@Ui.T($"הזמנה ללא הגבלה מאפשרת לאורחים לציין כל מספר עד {Guest.UnlimitedCap}. גם הזנת 0 משמעה ללא הגבלה.", $"With no limit the guests can name any number up to {Guest.UnlimitedCap}. Typing 0 means the same.")</small>
                <span asp-validation-for="Input.InvitedCount" class="field-validation-error"></span></div>
            <label class="field"><span>@Ui.T("סטטוס", "Status")</span>
                <select asp-for="Input.Status">
                    <option value="@RsvpStatus.Pending">@Labels.Status(RsvpStatus.Pending)</option>
                    <option value="@RsvpStatus.Attending">@Labels.Status(RsvpStatus.Attending)</option>
                    <option value="@RsvpStatus.Declined">@Labels.Status(RsvpStatus.Declined)</option>
                </select></label>
            <label class="field"><span>@Ui.T("מבוגרים שמגיעים", "Adults attending")</span><input asp-for="Input.AttendingAdults" type="number" min="1" />
                <span asp-validation-for="Input.AttendingAdults" class="field-validation-error"></span></label>
            <label class="field"><span>@Ui.T("ילדים שמגיעים", "Children attending")</span><input asp-for="Input.AttendingChildren" type="number" min="0" />
                <span asp-validation-for="Input.AttendingChildren" class="field-validation-error"></span></label>
        </div>
        <div class="fields">
            <label class="field"><span>@Ui.T("צמחוניים", "Vegetarian")</span><input asp-for="Input.DietVegetarian" type="number" min="0" />
                <span asp-validation-for="Input.DietVegetarian" class="field-validation-error"></span></label>
            <label class="field"><span>@Ui.T("טבעוניים", "Vegan")</span><input asp-for="Input.DietVegan" type="number" min="0" /></label>
            <label class="field"><span>@Ui.T("ללא גלוטן", "Gluten-free")</span><input asp-for="Input.DietGlutenFree" type="number" min="0" /></label>
        </div>
        <label class="field"><span>@Ui.T("אלרגיות והערות תזונה", "Allergies and dietary notes")</span><textarea asp-for="Input.DietNote" rows="2" maxlength="@Guest.DietNoteMax"></textarea></label>
        <label class="field"><span>@Ui.T("הערות", "Notes")</span><textarea asp-for="Input.Notes" rows="2"></textarea></label>
        <button type="submit" class="btn primary">@Ui.T("שמירה", "Save")</button>
    </form>
</section>

@if (Model.Existing is { } g)
{
    <div class="narrow">
    <section class="card">
        <h2>@Ui.T("קישור אישי", "Personal link")</h2>
        <p class="ltr"><a class="link" href="@Model.RsvpLink" target="_blank">@Model.RsvpLink</a></p>
        <p class="muted">
            @(g.Source == RsvpSource.Manual ? Ui.T("התשובה עודכנה ידנית.", "The answer was entered manually.") : g.Source == RsvpSource.Web ? Ui.T("האורח ענה דרך הקישור.", "The guest answered through the link.") : "")
            @Ui.T("פתחו את הקישור:", "Opened the link:") @Labels.Local(g.FirstOpenedAtUtc)
        </p>
        <div class="row">
            <form method="post" asp-page-handler="SendInvite" asp-route-id="@g.Id">
                <button type="submit" class="btn">@(g.InviteSentAtUtc is null ? Ui.T("שליחת הזמנה", "Send invitation") : Ui.T("שליחת ההזמנה שוב", "Send the invitation again"))</button>
            </form>
            <form method="post" asp-page-handler="Delete" asp-route-id="@g.Id" onsubmit="return confirm('@Ui.T("למחוק את האורח?", "Delete this guest?")')">
                <button type="submit" class="btn danger">@Ui.T("מחיקה", "Delete")</button>
            </form>
        </div>
    </section>
    <section class="card">
        <h2>@Ui.T("הודעות", "Messages")</h2>
        @foreach (var m in Model.Messages)
        {
            <div class="list-row">
                <div><b>@Labels.Kind(m.Kind)</b><div class="faint">@Labels.Local(m.SentAtUtc)@(m.Error is null ? "" : " · " + m.Error)</div></div>
                <span class="pill @Labels.DeliveryPill(m.Status)">@Labels.Delivery(m.Status)</span>
            </div>
        }
        @if (Model.Messages.Count == 0) { <p class="muted">@Ui.T("עוד לא נשלחו הודעות.", "No messages yet.")</p> }
    </section>
    </div>
}
</div>

<script>
    // The family name box is only needed for a new family (or to rename the selected one).
    (function () {
        var pick = document.getElementById('familyPick'), name = document.getElementById('familyName');
        if (!pick || !name) return;
        function sync() { name.style.display = pick.value === '0' ? 'none' : ''; }
        pick.addEventListener('change', function () { if (pick.value === '-1') name.value = ''; sync(); });
        sync();
    })();
    // "No guest limit" greys out the number box; typing 0 ticks the box.
    (function () {
        var box = document.getElementById('noLimit'), num = document.getElementById('invitedNumber');
        if (!box || !num) return;
        function sync() { num.disabled = box.checked; num.style.opacity = box.checked ? '.45' : ''; }
        box.addEventListener('change', sync);
        num.addEventListener('input', function () { if (num.value === '0') { box.checked = true; sync(); } });
        sync();
    })();
</script>
