@page
@model WeddingRsvp.Pages.Admin.EventModel
@using WeddingRsvp.Services
@{
    ViewData["Title"] = Ui.T("פרטי האירוע", "Event details");
    var s = Model.Settings;
    // What a message costs in credits, by the active provider's own rule. An unverified rule is shown as "about".
    var ruleU = Model.CostRule(true);
    var ruleG = Model.CostRule(false);
    string SegText(SegmentInfo i)
    {
        var rule = Model.CostRule(i.Unicode);
        var c = rule.Credits(i.Length);
        return Ui.IsHebrew
            ? $"{i.Length} תווים · {(rule.Estimated ? "כ-" : "")}{c} {(c == 1 ? "קרדיט" : "קרדיטים")}"
            : $"{i.Length} characters · {(rule.Estimated ? "about " : "")}{c} credit{(c == 1 ? "" : "s")}";
    }
    var presets = new[] { "#FFFFFF", "#F6F1E7", "#FBE9E7", "#E7F0EC", "#E8EEF6", "#1B2A2F", "#2B2237" };
}
<header class="page-head">
    <div><h1>@Ui.T("פרטי האירוע", "Event details")</h1>
        <div class="sub">@Ui.T("הכול כאן ריק עד שתמלאו. שום הודעה לא יוצאת עם שדה חסר.", "Everything here starts empty. No message is sent with a missing field.")</div></div>
</header>

<p class="hint"><a href="/admin/preview" target="_blank" rel="noopener">@Ui.T("תצוגה מקדימה של דף האורחים", "Preview the guest page")</a> · @Ui.T("שמרו קודם כדי לראות שינויים.", "Save first to see your changes.")</p>
<form method="post" id="main">
<div asp-validation-summary="All" class="banner err"></div>

<section class="card">
    <h2>@Ui.T("האירוע", "The event")</h2>
    <div class="fields">
        <label class="field"><span>@Ui.T("שמות בני הזוג", "Couple names")</span><input asp-for="Settings.CoupleNames" /></label>
        <label class="field"><span>@Ui.T("שמות בני הזוג (באנגלית)", "Couple names (English)")</span><input asp-for="Settings.CoupleNamesEn" class="ltr" />
            <small>@Ui.T("אופציונלי. אחרת ייעשה שימוש בשמות הרגילים.", "Optional. Otherwise the main names are used.")</small></label>
        <label class="field"><span>@Ui.T("כותרת הדף", "Page title")</span><input asp-for="Settings.Title" /></label>
        <label class="field"><span>@Ui.T("התחלה", "Starts")</span><input asp-for="Settings.StartsAtLocal" /></label>
        <label class="field"><span>@Ui.T("סיום", "Ends")</span><input asp-for="Settings.EndsAtLocal" /></label>
        <label class="field"><span>@Ui.T("אולם", "Venue")</span><input asp-for="Settings.VenueName" /></label>
        <label class="field"><span>@Ui.T("אולם (באנגלית)", "Venue (English)")</span><input asp-for="Settings.VenueNameEn" class="ltr" /></label>
        <label class="field"><span>@Ui.T("כתובת", "Address")</span><input asp-for="Settings.VenueAddress" /></label>
        <label class="field"><span>@Ui.T("כתובת (באנגלית)", "Address (English)")</span><input asp-for="Settings.VenueAddressEn" class="ltr" /></label>
        <label class="field"><span>@Ui.T("קו רוחב (לניווט)", "Latitude (for navigation)")</span><input asp-for="Settings.Latitude" class="ltr" placeholder="31.7683" /></label>
        <label class="field"><span>@Ui.T("קו אורך (לניווט)", "Longitude (for navigation)")</span><input asp-for="Settings.Longitude" class="ltr" placeholder="35.2137" /></label>
        <label class="field"><span>@Ui.T("קישור Waze (אם אין קואורדינטות)", "Waze link (used if there are no coordinates)")</span><input asp-for="Settings.WazeLink" class="ltr" inputmode="url" placeholder="https://waze.com/ul/..." />
            <span class="hint">@Ui.T("ב-Waze: חפשו את המקום, שתפו ובחרו העתקת קישור. אם הקישור כולל מיקום, נמלא את הקואורדינטות לבד והן ישמשו גם ל-Waze וגם ל-Google Maps.", "In Waze: find the place, tap Share and copy the link. If the link contains a location we fill in the coordinates for you and use them for both Waze and Google Maps.")</span></label>
        <label class="field"><span>@Ui.T("קישור Google Maps (אם אי אפשר לזהות מיקום מקישור Waze)", "Google Maps link (if the Waze link doesn't give a location)")</span><input asp-for="Settings.GoogleMapsLink" class="ltr" inputmode="url" placeholder="https://maps.app.goo.gl/..." /></label>
        @if (!string.IsNullOrWhiteSpace(s.WazeLink) && (s.Latitude is null || s.Longitude is null) && string.IsNullOrWhiteSpace(s.GoogleMapsLink))
        {
            <div class="banner warn">@Ui.T("לא הצלחנו לקרוא מיקום מקישור ה-Waze, אז אין עדיין כפתור Google Maps מדויק. הוסיפו קישור Google Maps, או קואורדינטות.", "We couldn't read a location from the Waze link, so the Google Maps button is only a search for the address. Add a Google Maps link, or coordinates.")</div>
        }
    </div>
</section>

<section class="card">
    <h2>@Ui.T("שפה", "Language")</h2>
    <p class="muted">@Ui.T("באיזו שפה האורחים מקבלים את ההודעה ואת הדף. בשתי השפות ההודעה כוללת את שני הטקסטים והדף כולל מתג שפה.",
        "Which language guests get in the message and on the page. With both, the SMS carries both texts and the page has a language toggle.")</p>
    <div class="fields">
        <label class="field"><span>@Ui.T("שפת האורחים", "Guest language")</span>
            <select asp-for="Settings.LanguageMode">
                <option value="@LanguageMode.HebrewOnly">@Ui.T("עברית בלבד", "Hebrew only")</option>
                <option value="@LanguageMode.EnglishOnly">@Ui.T("אנגלית בלבד", "English only")</option>
                <option value="@LanguageMode.Both">@Ui.T("עברית ואנגלית", "Hebrew and English")</option>
            </select></label>
        <div class="banner" id="bothcost" role="status" hidden>
            <p><b>@Ui.T("מצב עברית ואנגלית עלול לעלות יותר הודעות.", "Hebrew and English mode can cost more credits.")</b></p>
            <p>@Ui.T("כל הודעה כוללת את שני הטקסטים (ושני קישורים), ולכן היא ארוכה יותר. עברית מוגבלת בכל הודעה, וכל קטע נוסף נספר כהודעה נוספת. הערכה לפי הטקסטים שלמעלה:",
                "Each message carries both texts (and both links), so it is longer, and every extra stretch of text is billed as another credit. Estimate with the texts below:")</p>
            <ul id="bothcostlist" style="margin: 4px 0 0; padding-inline-start: 20px"></ul>
        </div>
        <label class="field"><span>@Ui.T("שפת ברירת מחדל בדף (כששתיהן)", "Default page language (when both)")</span>
            <select asp-for="Settings.DefaultGuestLanguage">
                <option value="he">עברית</option>
                <option value="en">English</option>
            </select></label>
    </div>
</section>

<section class="card">
    <h2>@Ui.T("ההודעות", "Messages")</h2>
    <p class="muted">@Ui.T("אפשר להשתמש ב:", "You can use:") <code class="ltr">@MessageTemplates.Placeholders</code>.
        @Ui.T($"הודעה עד {ruleU.SingleLimit} תווים (עברית) עולה קרדיט אחד, וכל {ruleU.PartLimit} תווים נוספים עולים קרדיט נוסף. באנגלית בלבד: {ruleG.SingleLimit} ו-{ruleG.PartLimit}. הקישור נספר כחלק מההודעה.",
            $"A message costs 1 credit up to {ruleU.SingleLimit} characters (Hebrew), plus 1 for each further {ruleU.PartLimit}. English only: {ruleG.SingleLimit} and {ruleG.PartLimit}. The link counts as part of the message.")
        @(Model.LongestGuestName is { } ln
            ? Ui.T($"הספירה משתמשת בשם האורח הארוך ביותר ברשימה ({ln}) ובערכים שמולאו למעלה.", $"Counts use your longest guest name ({ln}) and the values filled in above.")
            : Ui.T("הספירה משתמשת בשם לדוגמה עד שתהיה רשימת אורחים, ובערכים שמולאו למעלה.", "Counts use a sample name until you have guests, and the values filled in above."))</p>
    <label class="field"><span>@Ui.T("שם השולח", "Sender name")</span><input asp-for="Settings.SmsSenderName" class="ltr" maxlength="11" /></label>
    <div class="fields">
        <div>
            <h3>עברית</h3>
            <label class="field"><span>@Ui.T("הזמנה", "Invitation")</span><textarea asp-for="Settings.InviteTemplate" data-count="he" data-kind="invite" rows="3"></textarea><small>@SegText(Model.InviteSegments)</small></label>
            <label class="field"><span>@Ui.T("תזכורת", "Reminder")</span><textarea asp-for="Settings.ReminderTemplate" data-count="he" data-kind="reminder" rows="3"></textarea><small>@SegText(Model.ReminderSegments)</small></label>
            <label class="field"><span>@Ui.T("תודה", "Thank-you")</span><textarea asp-for="Settings.ThankYouTemplate" data-count="he" data-kind="thanks" rows="2"></textarea><small>@SegText(Model.ThankYouSegments)</small></label>
        </div>
        <div>
            <h3>English</h3>
            <label class="field"><span>@Ui.T("הזמנה", "Invitation")</span><textarea asp-for="Settings.InviteTemplateEn" data-count="en" data-kind="invite" rows="3" class="ltr"></textarea><small>@SegText(Model.InviteSegmentsEn)</small></label>
            <label class="field"><span>@Ui.T("תזכורת", "Reminder")</span><textarea asp-for="Settings.ReminderTemplateEn" data-count="en" data-kind="reminder" rows="3" class="ltr"></textarea><small>@SegText(Model.ReminderSegmentsEn)</small></label>
            <label class="field"><span>@Ui.T("תודה", "Thank-you")</span><textarea asp-for="Settings.ThankYouTemplateEn" data-count="en" data-kind="thanks" rows="2" class="ltr"></textarea><small>@SegText(Model.ThankYouSegmentsEn)</small></label>
        </div>
    </div>
    <h3>@Ui.T("תצוגה מקדימה של ההזמנה", "Invitation preview")</h3>
    <pre class="sms-preview">@Model.PreviewBody</pre>
    <p class="faint">@SegText(Model.PreviewSegments) · @Ui.T("מתעדכן אחרי שמירה", "updates after saving")</p>
</section>

<section class="card">
    <h2>@Ui.T("עיצוב דף האורחים", "Guest page look")</h2>
    <p class="muted">@Ui.T("הצבעים חלים על הדף שהאורחים רואים. הכרטיסים נשארים לבנים.", "These apply to the page guests see. The cards stay white.")</p>
    <div class="fields">
        <partial name="_ColorPicker" model='new ColorPicker(Ui.T("צבע רקע", "Background colour"), "Settings.PageBackgroundColor", s.PageBackgroundColor, HexColor.DefaultBackground, presets)' />
        <partial name="_ColorPicker" model='new ColorPicker(Ui.T("צבע כפתור", "Button colour"), "Settings.PageAccentColor", s.PageAccentColor, HexColor.DefaultAccent, new[] { "#1F6F5F", "#2F5D8A", "#7A4E8C", "#A8553A", "#1B2A2F" })' />
    </div>
</section>

<section class="card">
    <h2>@Ui.T("תזמון", "Schedule")</h2>
    <div class="fields">
        <label class="field"><span>@Ui.T("שליחת הזמנות אוטומטית ב-", "Send invitations automatically at")</span><input asp-for="Settings.AutoInviteAtLocal" />
            <small>@Ui.T("השאירו ריק כדי לשלוח ידנית מעמוד ההודעות.", "Leave empty to send manually from the Messages page.")</small></label>
    </div>
    <label class="checks"><input asp-for="Settings.RemindersEnabled" /> @Ui.T("תזכורות למי שלא ענו", "Remind guests who haven't answered")</label>
    <div class="fields">
        <label class="field"><span>@Ui.T("כל כמה ימים", "Every how many days")</span><input asp-for="Settings.ReminderIntervalDays" type="number" min="1" /></label>
        <label class="field"><span>@Ui.T("מקסימום תזכורות", "Maximum reminders")</span><input asp-for="Settings.MaxReminders" type="number" min="0" /></label>
    </div>
    <label class="checks"><input asp-for="Settings.ThankYouEnabled" /> @Ui.T("הודעת תודה יום אחרי האירוע", "Thank-you message the day after the event")</label>
    <div class="fields">
        <label class="field"><span>@Ui.T("בשעה", "At hour")</span><input asp-for="Settings.ThankYouHourLocal" type="number" min="0" max="23" /></label>
        <label class="field"><span>@Ui.T("למי", "To whom")</span>
            <select asp-for="Settings.ThankYouAudience">
                <option value="@ThankYouAudience.AttendingOnly">@Ui.T("רק למי שאישרו הגעה", "Only guests who confirmed")</option>
                <option value="@ThankYouAudience.EveryoneInvited">@Ui.T("לכל המוזמנים", "Everyone invited")</option>
            </select></label>
    </div>
</section>

<div><button type="submit" class="btn primary">@Ui.T("שמירה", "Save")</button></div>
</form>

<section class="card">
    <h2>@Ui.T("תמונות", "Images")</h2>
    <p class="muted">@Ui.T("תמונת ההזמנה היא עיקר דף האורחים. אפשר להעלות אחת לכל שפה; אם חסרה, תוצג השנייה.", "The invitation image is the heart of the guest page. Upload one per language; if one is missing the other is shown.")</p>
    <div class="steps">
        <partial name="_ImageSlot" model='new ImageSlot("he", Ui.T("הזמנה בעברית", "Hebrew invitation"), Model.HasImage, s.InvitationImageUpdatedAtUtc?.Ticks, "he")' />
        <partial name="_ImageSlot" model='new ImageSlot("en", Ui.T("הזמנה באנגלית", "English invitation"), Model.HasImageEn, s.InvitationImageEnUpdatedAtUtc?.Ticks, "en")' />
        <partial name="_ImageSlot" model='new ImageSlot("bg", Ui.T("תמונת רקע לדף (אופציונלי)", "Page background photo (optional)"), Model.HasBackground, s.PageBackgroundImageUpdatedAtUtc?.Ticks, null)' />
    </div>
</section>

<script>
    // Live length and credit count while typing, using the active provider's rule (SmsCostRule), not a hardcoded one.
    (function () {
        var rules = { u: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { single = ruleU.SingleLimit, part = ruleU.PartLimit, est = ruleU.Estimated })),
                      g: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { single = ruleG.SingleLimit, part = ruleG.PartLimit, est = ruleG.Estimated })) };
        var samples = { he: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SampleHe)), en: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SampleEn)) };
        var text = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            chars = Ui.T("תווים", "characters"), one = Ui.T("קרדיט", "credit"), many = Ui.T("קרדיטים", "credits"),
            about = Ui.T("כ-", "about "), empty = Ui.T("עוד לא מולא למעלה:", "not filled in above yet:"),
            hebrewOnly = Ui.T("עברית בלבד", "Hebrew only"),
            kinds = new { invite = Ui.T("הזמנה", "Invitation"), reminder = Ui.T("תזכורת", "Reminder"), thanks = Ui.T("תודה", "Thank-you") },
        }));
        function val(id) { var e = document.getElementById(id); return e ? e.value.trim() : ''; }
        // Placeholder values come from the fields on this page as they are right now (saved or not), like the real message will.
        function values(lang) {
            var en = lang === 'en', base = samples[lang], d = /^(\d{4})-(\d{2})-(\d{2})/.exec(val('Settings_StartsAtLocal'));
            return {
                name: base.name, link: base.link,
                couple: (en && val('Settings_CoupleNamesEn')) || val('Settings_CoupleNames'),
                venue: (en && val('Settings_VenueNameEn')) || val('Settings_VenueName'),
                date: d ? d[3] + '/' + d[2] : '00/00' // always dd/MM once a date is set
            };
        }
        function render(area) {
            var v = values(area.dataset.count), t = area.value;
            return t.split('{name}').join(v.name).split('{couple}').join(v.couple).split('{link}').join(v.link)
                .split('{date}').join(v.date).split('{venue}').join(v.venue).trim();
        }
        function creditsFor(rendered) {
            var unicode = /[^\x00-\x7F]/.test(rendered); // any non-ASCII is treated as UCS-2 (a safe over-estimate for accented Latin)
            var r = unicode ? rules.u : rules.g, len = rendered.length;
            return { len: len, est: r.est, credits: len <= r.single ? 1 : 1 + Math.ceil((len - r.single) / r.part) };
        }
        function update(area) {
            var v = values(area.dataset.count), t = area.value, c = creditsFor(render(area));
            var empty = ['couple', 'venue'].filter(function (k) { return t.indexOf('{' + k + '}') >= 0 && !v[k]; })
                .map(function (k) { return '{' + k + '}'; });
            area.parentElement.querySelector('small').textContent =
                c.len + ' ' + text.chars + ' · ' + (c.est ? text.about : '') + c.credits + ' ' + (c.credits === 1 ? text.one : text.many)
                + (empty.length ? ' · ' + text.empty + ' ' + empty.join(' ') : '');
        }
        // Hebrew and English mode: one SMS holds both texts and an empty line between them, so it is longer and can cost more.
        function updateBoth() {
            var mode = document.getElementById('Settings_LanguageMode'), box = document.getElementById('bothcost');
            if (!mode || !box) return;
            box.hidden = mode.value !== 'Both';
            if (box.hidden) return;
            var list = document.getElementById('bothcostlist'); list.innerHTML = '';
            ['invite', 'reminder', 'thanks'].forEach(function (kind) {
                var he = document.querySelector('textarea[data-count=he][data-kind=' + kind + ']');
                var en = document.querySelector('textarea[data-count=en][data-kind=' + kind + ']');
                if (!he || !en) return;
                var h = render(he), both = creditsFor(h + '\n\n' + render(en)), only = creditsFor(h);
                var li = document.createElement('li');
                li.textContent = text.kinds[kind] + ': ' + (both.est ? text.about : '') + both.credits + ' ' + (both.credits === 1 ? text.one : text.many)
                    + ' (' + text.hebrewOnly + ': ' + only.credits + ')';
                list.appendChild(li);
            });
        }
        function updateAll() { document.querySelectorAll('textarea[data-count]').forEach(update); updateBoth(); }
        document.querySelectorAll('textarea[data-count]').forEach(function (a) { a.addEventListener('input', function () { update(a); updateBoth(); }); });
        var modeSel = document.getElementById('Settings_LanguageMode'); if (modeSel) modeSel.addEventListener('change', updateBoth);
        ['Settings_CoupleNames', 'Settings_CoupleNamesEn', 'Settings_VenueName', 'Settings_VenueNameEn', 'Settings_StartsAtLocal'].forEach(function (id) {
            var e = document.getElementById(id);
            if (e) { e.addEventListener('input', updateAll); e.addEventListener('change', updateAll); }
        });
        updateAll();
    })();
    // Colour fields: the hex box is what gets saved; the chip (also a native picker) and the swatches follow it.
    (function () {
        var text = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            hex = Ui.T("הזינו צבע בצורה #RRGGBB", "Use the form #RRGGBB, for example #1F6F5F"),
            def = Ui.T("ברירת מחדל", "Default"), custom = Ui.T("צבע מותאם אישית", "Custom colour"),
        }));
        var HEX = /^#[0-9a-fA-F]{6}$/;
        document.querySelectorAll('.colorpick').forEach(function (box) {
            var input = box.querySelector('.colortext'), chip = box.querySelector('.colorchip'), msg = box.querySelector('.colormsg');
            var reset = box.querySelector('.colorreset'), swatches = box.querySelectorAll('.swatch'), dflt = box.dataset.default;
            function sync() {
                var v = input.value.trim(), blank = v === '', valid = HEX.test(v), preset = false;
                if (blank) chip.value = dflt.toLowerCase(); else if (valid) chip.value = v.toLowerCase();
                chip.classList.toggle('isdefault', blank);
                input.classList.toggle('invalid', !blank && !valid);
                swatches.forEach(function (s) {
                    var on = valid && s.dataset.color.toLowerCase() === v.toLowerCase();
                    preset = preset || on;
                    s.classList.toggle('selected', on);
                    s.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
                reset.classList.toggle('selected', blank);
                msg.classList.toggle('bad', !blank && !valid);
                msg.textContent = blank ? text.def + ' ' + dflt : !valid ? text.hex : preset ? '' : text.custom + ' ' + v.toUpperCase();
            }
            swatches.forEach(function (s) { s.addEventListener('click', function () { input.value = s.dataset.color; sync(); }); });
            chip.addEventListener('input', function () { input.value = chip.value.toUpperCase(); sync(); });
            input.addEventListener('input', sync);
            reset.addEventListener('click', function () { input.value = ''; sync(); });
            sync();
        });
    })();
</script>
