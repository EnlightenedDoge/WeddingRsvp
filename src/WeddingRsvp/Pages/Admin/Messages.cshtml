@page
@model WeddingRsvp.Pages.Admin.MessagesModel
@{
    ViewData["Title"] = Ui.T("הודעות", "Messages");
    int C(MessageStatus s) => Model.Counts.TryGetValue(s, out var n) ? n : 0;
    var blocked = Model.MissingForInvite.Count > 0;
}
<header class="page-head">
    <div><h1>@Ui.T("הודעות", "Messages")</h1></div>
    <div class="row">
        <span class="status-on @(Model.Event.SendingPaused ? "off" : "")"><i></i>@(Model.Event.SendingPaused ? Ui.T("השליחה מושהית", "Sending is paused") : Ui.T("השליחה פעילה", "Sending is active"))</span>
        <form method="post" asp-page-handler="TogglePause">
            <button type="submit" class="btn">@(Model.Event.SendingPaused ? Ui.T("חידוש השליחה", "Resume sending") : Ui.T("השהיית שליחה", "Pause sending"))</button>
        </form>
    </div>
</header>

@if (!Model.Event.SendingPaused && !Model.InSendingWindow)
{
    <p class="banner">@Ui.T("מחוץ לשעות השליחה (לילה, שבת או חג). הודעות בתור ייצאו כשהחלון ייפתח.", "Outside the sending hours (night, Saturday or a holiday). Queued messages go out when the window opens.")</p>
}

@if (Model.Delayed)
{
    <p class="banner" role="status">@Ui.T("שליחת ההודעות מתעכבת כרגע. ההודעות בתור יישלחו אוטומטית.", "Messages are delayed right now. Queued messages will go out automatically.")</p>
}
<p class="banner @(Model.Remaining < Model.InviteCredits ? "err" : "ok")">@Ui.T("הודעות שנותרו בהקצאה שלכם", "Messages left in your allocation"): <b>@Model.Remaining</b>
    @if (Model.InviteCredits > 0)
    {
        <span> · @Ui.T($"ההזמנות שטרם נשלחו ידרשו בערך {Model.InviteCredits}", $"the invitations still to send will need about {Model.InviteCredits}")</span>
    }
    @if (Model.Remaining < Model.InviteCredits)
    {
        <span> · @Ui.T("זה יותר ממה שנותר; הודעות יישארו בתור עד להגדלת ההקצאה.", "that is more than you have left; messages will wait in the queue until the allocation is raised.")</span>
    }
</p>
@if (Model.BothMode)
{
    <p class="banner" role="status"><b>@Ui.T("מצב עברית ואנגלית:", "Hebrew and English mode:")</b>
        @Ui.T("כל הודעה כוללת את שני הטקסטים, ולכן היא ארוכה ועלולה לעלות יותר הודעות", "every message carries both texts, so it is longer and can cost more credits")
        @if (Model.PerInviteCredits > 0) { <span>(@Ui.T($"הזמנה: בערך {Model.PerInviteCredits}", $"an invitation: about {Model.PerInviteCredits}")).</span> }
        else { <span>.</span> }
        <a class="link" href="/admin/event">@Ui.T("לשינוי המצב", "Change the mode")</a></p>
}

<div class="grid2">
<section class="card wide">
    <h2>@Ui.T("הזמנות", "Invitations")</h2>
    <p>@Ui.T($"{Model.ReadyToInvite} אורחים עם מספר תקין עוד לא קיבלו הזמנה.", $"{Model.ReadyToInvite} guests with a valid number haven't been invited yet.")</p>
    @if (blocked)
    {
        <div class="banner err" role="alert">
            <p><b>@Ui.T("עדיין אי אפשר לשלוח הזמנות.", "Invitations can't be sent yet.")</b></p>
            <p>@Ui.T("ההודעה משתמשת בשדות שלא הוגדרו בפרטי האירוע:", "The message uses fields that are not set in the event details:")</p>
            <p class="ltr">@string.Join("  ", Model.MissingForInvite)</p>
            <a class="link" href="/admin/event">@Ui.T("השלמת פרטי האירוע", "Complete the event details")</a>
        </div>
    }
    <form method="post" asp-page-handler="QueueInvites" onsubmit="return confirm('@Ui.T("לשלוח הזמנות לכל מי שעוד לא קיבל?", "Send invitations to everyone not yet invited?")')" style="margin-block-start: 16px">
        <button type="submit" class="btn primary" disabled="@(Model.ReadyToInvite == 0 || blocked)">@Ui.T("שליחת הזמנות", "Send invitations")</button>
    </form>
</section>

<div class="narrow">
<section class="card">
    <h2>@Ui.T("גיל ילדים", "Children's age")</h2>
    <p class="hint">@Ui.T("אופציונלי. הטווח מוצג לאורחים ליד בחירת מספר הילדים (בדף ההזמנה ובקישורים קבוצתיים). אפשר למלא רק צד אחד, למשל \"עד גיל 12\".", "Optional. Shown to guests next to the number of children (on the invitation and on group links). You can fill in just one end, e.g. \"up to age 12\".")</p>
    <form method="post" asp-page-handler="ChildAge">
        <div class="fields">
            <label class="field"><span>@Ui.T("מגיל", "From age")</span><input name="ChildMinAge" type="number" min="0" max="@EventSettings.MaxChildAge" value="@Model.Event?.ChildMinAge" inputmode="numeric" /></label>
            <label class="field"><span>@Ui.T("עד גיל", "Up to age")</span><input name="ChildMaxAge" type="number" min="0" max="@EventSettings.MaxChildAge" value="@Model.Event?.ChildMaxAge" inputmode="numeric" /></label>
        </div>
        <button type="submit" class="btn">@Ui.T("שמירה", "Save")</button>
    </form>
</section>
<section class="card">
    <h2>@Ui.T("הודעת בדיקה", "Test message")</h2>
    <p class="hint"><a href="/admin/preview" target="_blank" rel="noopener">@Ui.T("תצוגה מקדימה של דף האורחים", "Preview the guest page")</a> · @Ui.T("כך האורחים יראו את ההזמנה. אפשר ללחוץ על התשובות, שום דבר לא נשמר.", "This is what guests see. You can press the answers; nothing is saved.")</p>
    <form method="post" asp-page-handler="Test">
        <label class="field"><span>@Ui.T("טלפון", "Phone")</span><input name="TestPhone" class="ltr" inputmode="tel" placeholder="050-0000000" /></label>
        <label class="field"><span>@Ui.T("סוג", "Type")</span>
            <select name="TestTemplate">
                <option value="@MessageKind.Invite">@Ui.T("הזמנה", "Invitation")</option>
                <option value="@MessageKind.Reminder">@Ui.T("תזכורת", "Reminder")</option>
                <option value="@MessageKind.ThankYou">@Ui.T("תודה", "Thank-you")</option>
            </select></label>
        <button type="submit" class="btn">@Ui.T("שליחה", "Send")</button>
    </form>
</section>
</div>
</div>

<section class="card">
    <h2>@Ui.T("סטטוס", "Status")</h2>
    <div class="row" style="gap: 28px; margin-block-end: 8px">
        <div><b style="font-size: 26px">@C(MessageStatus.Queued)</b><div class="muted">@Ui.T("בתור", "Queued")</div></div>
        <div><b style="font-size: 26px">@C(MessageStatus.Sent)</b><div class="muted">@Ui.T("נשלחו", "Sent")</div></div>
        <div><b style="font-size: 26px">@C(MessageStatus.Delivered)</b><div class="muted" title="@Ui.T("הספק אישר שההודעה נמסרה", "The provider confirmed delivery")">@Ui.T("נמסרו", "Delivered")</div></div>
        <div><b style="font-size: 26px">@C(MessageStatus.Opened)</b><div class="muted" title="@Ui.T("הקישור בהודעה נפתח", "The link in the message was opened")">@Ui.T("נפתחו", "Opened")</div></div>
        <div><b style="font-size: 26px; color: @(C(MessageStatus.Failed) > 0 ? "var(--danger)" : "inherit")">@C(MessageStatus.Failed)</b><div class="muted">@Ui.T("נכשלו", "Failed")</div></div>
        <div><b style="font-size: 26px">@C(MessageStatus.Cancelled)</b><div class="muted">@Ui.T("בוטלו", "Cancelled")</div></div>
    </div>
    @if (C(MessageStatus.Failed) > 0)
    {
        <form method="post" asp-page-handler="RequeueFailed">
            <button type="submit" class="btn">@Ui.T("ניסיון חוזר לכל ההודעות שנכשלו", "Retry all failed messages")</button>
        </form>
    }
    <div class="tablewrap">
    <table>
        <thead><tr><th>@Ui.T("אורח", "Guest")</th><th>@Ui.T("סוג", "Type")</th><th>@Ui.T("סטטוס", "Status")</th><th>@Ui.T("נוצרה", "Created")</th><th>@Ui.T("נשלחה", "Sent")</th><th>@Ui.T("שגיאה", "Error")</th></tr></thead>
        <tbody>
        @foreach (var m in Model.Recent)
        {
            <tr>
                <td>@if (m.Guest is { } g) { <a href="/admin/guests/edit/@g.Id">@g.Name</a> } else { <span class="ltr">@m.ToE164</span> }</td>
                <td>@Labels.Kind(m.Kind)</td>
                <td><span class="pill @Labels.DeliveryPill(m.Status)">@Labels.Delivery(m.Status)</span></td>
                <td>@Labels.Local(m.CreatedAtUtc)</td>
                <td>@Labels.Local(m.SentAtUtc)</td>
                <td>@m.Error</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</section>

<section class="card" id="groups">
    <h2>@Ui.T("קישורים קבוצתיים", "Group links")</h2>
    <p class="muted">@Ui.T("קישור אחד לקבוצה שלמה, למשל בקבוצת וואטסאפ. כל מי שנכנס מזין טלפון ושם, ומי שעונה נוסף לרשימת האורחים. לא נשלחות הודעות SMS בשבילם.",
        "One link for a whole group, for example in a WhatsApp group. Everyone who opens it enters a phone and name, and whoever answers is added to your guest list. No SMS is sent for them.")</p>
    <form method="post" asp-page-handler="CreateGroup">
        <div class="fields">
            <label class="field"><span>@Ui.T("שם הקבוצה", "Group name")</span><input name="GroupName" maxlength="100" required placeholder="@Ui.T("החברים מהעבודה", "Friends from work")" /></label>
            <div class="field"><span>@Ui.T("מקסימום אורחים בתשובה", "Max guests per answer")</span><div class="row"><input name="GroupMax" id="gMax" type="number" min="1" max="50" value="4" style="max-width: 120px" /><label class="checks"><input type="checkbox" name="GroupNoLimit" value="true" id="gNoLimit" /> @Ui.T("ללא הגבלה", "No guest limit")</label></div></div>
        </div>
        <div class="field">
            <label class="checks"><input type="checkbox" name="GroupVerify" value="@((int)GroupVerifyMode.OnEdit)" id="gVerify" /> @Ui.T("אימות SMS של מספר הטלפון (בעריכה או במעבר לתשובה עצמאית)", "SMS phone verification (when editing or taking over)")</label>
            <small>@Ui.T("כל קוד הוא הודעת SMS אחת מההקצאה שלכם. אפשר לשנות לאימות בכל כניסה בעריכת הקישור.", "Each code is one SMS from your allocation. Edit the link to verify on every visit instead.")</small>
        </div>
        <div class="field">
            <label class="checks"><input type="checkbox" name="GroupHasExpiry" value="true" id="gHasExp" /> @Ui.T("תאריך תפוגה (לא חובה)", "Expiry date (optional)")</label>
            <input type="datetime-local" name="GroupExpiresAt" id="gExp" style="max-width: 280px" disabled />
        </div>
        <button type="submit" class="btn primary">@Ui.T("יצירת קישור קבוצתי", "Create group link")</button>
    </form>
    @if (Model.GroupRows.Count > 0)
    {
        <div class="tablewrap" style="margin-block-start: 16px">
        <table>
            <thead><tr><th>@Ui.T("קבוצה", "Group")</th><th>@Ui.T("קישור", "Link")</th><th>@Ui.T("תשובות", "Answers")</th><th>@Ui.T("סטטוס", "Status")</th><th>@Ui.T("אימות SMS", "SMS verification")</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.GroupRows)
            {
                <tr>
                    <td><b>@r.Link.Name</b></td>
                    <td><span class="ltr">@Model.GroupUrl(r.Link)</span> <button type="button" class="btn copy" data-copy="@Model.GroupUrl(r.Link)">@Ui.T("העתקה", "Copy")</button></td>
                    <td>@r.Answers @Ui.T("תשובות", "answers") · @r.Guests @Ui.T("אורחים", "guests")</td>
                    <td><span class="pill @(r.Status == GroupLinkStatus.Active ? "ok" : r.Status == GroupLinkStatus.Expired ? "wait" : "")">@(r.Status switch { GroupLinkStatus.Active => Ui.T("פעיל", "Active"), GroupLinkStatus.Expired => Ui.T("פג תוקף", "Expired"), _ => Ui.T("מושבת", "Off") })</span></td>
                    <td>@(r.Link.VerifyMode switch { GroupVerifyMode.OnEdit => Ui.T("בעריכה", "On edit"), GroupVerifyMode.Always => Ui.T("בכל כניסה", "Every visit"), _ => Ui.T("כבוי", "Off") })</td>
                    <td class="actions">
                        <a class="link" href="/admin/groups/@r.Link.Id">@Ui.T("תשובות", "Answers")</a>
                        <a class="link" href="/admin/groups?edit=@r.Link.Id">@Ui.T("עריכה", "Edit")</a>
                        @if (r.Status != GroupLinkStatus.Expired)
                        {
                            <form method="post" asp-page-handler="ToggleGroup" asp-route-id="@r.Link.Id" class="inline"><button type="submit" class="link">@(r.Status == GroupLinkStatus.Off ? Ui.T("הפעלה", "Turn on") : Ui.T("השבתה", "Turn off"))</button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</section>
<script>
    document.querySelectorAll('#groups button.copy').forEach(function (b) {
        b.addEventListener('click', function () {
            var done = function () { var t = b.textContent; b.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Ui.T("הועתק", "Copied"))); setTimeout(function () { b.textContent = t; }, 1500); };
            if (navigator.clipboard) navigator.clipboard.writeText(b.dataset.copy).then(done); else done();
        });
    });
    var gh = document.getElementById('gHasExp'), ge = document.getElementById('gExp');
    var gn = document.getElementById('gNoLimit'), gm = document.getElementById('gMax');
    gn.addEventListener('change', function () { gm.disabled = gn.checked; });
    gh.addEventListener('change', function () { ge.disabled = !gh.checked; });
</script>

