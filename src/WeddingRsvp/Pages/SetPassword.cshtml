@page "/set-password"
@model WeddingRsvp.Pages.SetPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Ui.T("בחירת סיסמה", "Choose a password");
}
<h1>@Ui.T("בחירת סיסמה", "Choose a password")</h1>
@if (Model.Invalid)
{
    <p class="banner err" role="alert">@Ui.T("הקישור אינו תקף או שכבר נעשה בו שימוש. בקשו קישור חדש ממנהל האתר.",
        "This link is invalid or has already been used. Ask the site admin for a new one.")</p>
}
else
{
    @if (Model.Error is not null)
    {
        <p class="banner err" role="alert">@Model.Error</p>
    }
    <form method="post">
        <input type="hidden" name="u" value="@Model.UserId" />
        <input type="hidden" name="t" value="@Model.Token" />
        <label class="field"><span>@Ui.T("סיסמה חדשה (לפחות 10 תווים)", "New password (at least 10 characters)")</span>
            <input name="Password" type="password" autocomplete="new-password" minlength="10" required autofocus /></label>
        <label class="field"><span>@Ui.T("אימות סיסמה", "Confirm password")</span>
            <input name="Confirm" type="password" autocomplete="new-password" minlength="10" required /></label>
        <partial name="_Turnstile" model='"set-password"' />
        <button type="submit" class="btn primary">@Ui.T("שמירה וכניסה", "Save and continue")</button>
    </form>
}
